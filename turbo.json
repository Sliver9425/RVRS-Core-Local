{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "// --- TAREAS DE DESPLIEGUE ---": {},
    "deploy:docker": {
      "dependsOn": ["build"],
      "cache": false,
      "inputs": [
        "src/**",
        "apps/**/Dockerfile",
        "services/**/Dockerfile",
        "gateway/Dockerfile",
        "index.js",
        "main.py",
        "package.json",
        "nginx.conf"
      ]
    }
  }
}