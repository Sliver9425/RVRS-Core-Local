{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "// --- NUEVAS TAREAS PARA CI/CD ---": {},
    "deploy:docker": {
      "dependsOn": ["build"],
      "cache": true,
      "inputs": [
        "src/**", 
        "Dockerfile", 
        "index.js", 
        "main.py", 
        "package.json"
      ]
    }
  }
}
